{
  "name": "qureo-study-helper",
  "version": "1.7.0",
  "private": true,
  "description": "Arabic mobile-first general assistant with a safe QUREO mode, cloud fallback and optional local inference",
  "scripts": {
    "start": "node server.js",
    "preview": "MOCK_MODE=1 node server.js",
    "test": "node --test tests/*.test.js",
    "test:worker": "node --test tests/worker.test.js",
    "eval": "node scripts/eval.js",
    "code": "node cli/mohamed-code.js"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "mohamed-code": "cli/mohamed-code.js"
  }
}
