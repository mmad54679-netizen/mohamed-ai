# Optional CrewAI planning service. Use only on a private local network or via HTTPS.
TEAM_SERVICE_URL=http://127.0.0.1:8081
TEAM_SERVICE_TOKEN=replace-with-a-long-random-secret
TEAM_SERVICE_ALLOW_HTTP=1
TEAM_TIMEOUT_MS=120000

# Optional MetaGPT isolated builder; requires Python 3.11 in its separate container.
METAGPT_SERVICE_URL=http://127.0.0.1:8082
METAGPT_SERVICE_TOKEN=replace-with-a-different-long-random-secret
METAGPT_SERVICE_ALLOW_HTTP=1
METAGPT_TIMEOUT_MS=600000
MAX_TEAM_ARCHIVE_BYTES=104857600
